# Copy this file to .env and fill in real values. Never commit .env itself
# (it's already in .gitignore).

# Required. Signs and verifies login session tokens. Must be a long, random,
# unguessable string - the server refuses to start without one. Generate one
# with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port the Node process listens on. In production this normally sits behind
# a reverse proxy (nginx/Caddy) that terminates TLS and forwards to this
# port over localhost - see SECURITY.md for the recommended setup.
PORT=3000

# Set to "production" on the real server. Enables the HTTP -> HTTPS redirect
# (which relies on your reverse proxy setting X-Forwarded-Proto).
NODE_ENV=development

# Comma-separated list of origins allowed to call this API. Should be your
# real site origin(s) only, e.g.:
#   ALLOWED_ORIGINS=https://fcs.caves.org
# Add a local dev origin only while developing locally, e.g.:
#   ALLOWED_ORIGINS=https://fcs.caves.org,http://localhost:3000
# Also used to build the link inside password-reset emails (the first
# origin in the list), so keep your real production URL first.
ALLOWED_ORIGINS=https://fcs.caves.org

# Optional. Without these set, "forgot password" reset links are logged to
# the server console instead of emailed - fine for local development, not
# for production. To send real email, fill in an SMTP account (Gmail App
# Passwords, SendGrid, Mailgun, your host's mail server, etc.):
#   SMTP_HOST=smtp.example.com
#   SMTP_PORT=587
#   SMTP_SECURE=false        # true if your provider uses port 465
#   SMTP_USER=you@example.com
#   SMTP_PASS=your-smtp-password-or-api-key
#   SMTP_FROM=noreply@fcs.caves.org   # defaults to SMTP_USER if unset
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional. Enables passwordless "Sign in with Google" for exactly ONE
# pre-designated account (POST /api/google-login) - everyone else keeps
# using their username/password exactly as before; this doesn't touch any
# other login path. Leave both unset and the feature is simply off (503).
#
# Setup (one-time, in https://console.cloud.google.com):
#   1. Create/select a project, then "APIs & Services" -> "Credentials".
#   2. Configure the OAuth consent screen if you haven't already (External
#      or Internal, doesn't matter for this - "Testing" mode is fine since
#      only your own account will ever sign in).
#   3. Create an OAuth client ID of type "Android": set the package name to
#      com.floridacavesurvey.android and the SHA-1 of the signing
#      certificate the Android app is built with.
#   4. Create a SECOND OAuth client ID of type "Web application" (no redirect
#      URIs needed). Its Client ID is what goes below - the Android app uses
#      it as the "server client ID" when requesting a sign-in, which is why
#      the ID token's audience ends up being this one, not the Android
#      client's own ID.
#   5. Put that Web client's Client ID here:
GOOGLE_OAUTH_CLIENT_ID=
# The Google account email allowed to use this login path. Must exactly
# match the "email" field of an existing, active user in data/users.json
# whose role is "webmaster" - google-login is refused for any other role or
# any other email, even if this were somehow misconfigured.
GOOGLE_WEBMASTER_EMAIL=
